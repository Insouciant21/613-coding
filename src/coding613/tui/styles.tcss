Screen {
    layout: vertical;
    background: #101214;
    color: #e8e8e2;
}

ConversationLog {
    width: 100%;
    height: 1fr;
    padding: 0 1;
    scrollbar-color: #6d8b74;
    scrollbar-background: #1a1e21;
}

.conversation-entry {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.config-menu {
    height: auto;
    max-height: 12;
    border: solid #6d8b74;
    background: #17191b;
    color: #e8e8e2;
    padding: 0 1;
}

ProviderEditorScreen, ProviderKeyScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#provider-editor {
    width: 78;
    max-height: 92%;
    border: solid #d4c59a;
    background: #17191b;
    padding: 1 2;
}

#provider-key-editor {
    width: 64;
    height: auto;
    border: solid #d4c59a;
    background: #17191b;
    padding: 1 2;
}

.provider-form-title {
    height: auto;
    color: #d4c59a;
    text-style: bold;
    padding: 0 0 1 0;
}

.provider-form-help {
    height: auto;
    color: #a9c7b0;
    padding: 0 0 1 0;
}

#provider-editor VerticalScroll {
    height: 1fr;
    scrollbar-color: #6d8b74;
    scrollbar-background: #1a1e21;
}

#provider-editor Input, #provider-editor Select, #provider-key-editor Input {
    width: 100%;
    margin: 0 0 1 0;
}

.provider-form-actions {
    height: 3;
    align: right middle;
}

.provider-form-actions Button {
    margin-left: 1;
}

.user-message {
    color: #d4c59a;
}

.assistant-message {
    color: #e8e8e2;
}

.tool-result, .validation-result {
    background: #101214;
    color: #e8e8e2;
}

.approval-view {
    height: 10;
    max-height: 1fr;
    overflow-y: scroll;
    border: solid #d4c59a;
    padding: 0 1;
}

.approval-header {
    height: auto;
    padding: 0 0 1 0;
}

ActiveOperation {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #1a1e21;
    color: #a9c7b0;
}

TaskComposer {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 0 1;
    background: #17191b;
    color: #f2f1eb;
    border-top: solid #5f6f65;
}

CommandHints {
    width: 100%;
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: #1a1e21;
    color: #a9c7b0;
}

UsageHints {
    width: 100%;
    height: auto;
    max-height: 2;
    padding: 0 1;
    background: #17191b;
    color: #87958a;
}

StatusFooter {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #26292c;
    color: #d4c59a;
}
